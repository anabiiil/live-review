{
  "name": "livereview",
  "version": "0.1.0",
  "description": "Live read-only view of a git working tree and commits for invited reviewers",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node bin/livereview.js",
    "test": "node --import ./test/helpers/quiet-sqlite.js --test --test-concurrency=1 \"test/**/*.test.js\""
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "diff2html": "^3",
    "ws": "^8"
  },
  "bin": {
    "livereview": "bin/livereview.js"
  }
}
